\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pku-figures}[2026/11/18 Reusable vector figure examples]
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,calc}
\pgfplotscreateplotcyclelist{pku-series}{%
  pku-primary,solid,mark=*\\%
  pku-noir,dashed,mark=square*\\%
  pku-primary!55!white,dashdotted,mark=triangle*\\%
  pku-secondary,dotted,mark=diamond*\\%
}
\pgfplotsset{pku axis/.style={
  axis lines=left,axis line style={pku-muted},
  tick style={pku-muted},tick label style={font=\small,color=pku-muted},
  label style={font=\small,color=pku-ink},
  grid=major,grid style={pku-line,densely dotted},
  legend style={draw=none,fill=none,font=\small,text=pku-ink},
  cycle list name=pku-series,mark repeat=12,
  every axis plot/.append style={semithick,mark size=1.6pt},
}}
% Analytic illustration, not measured data. Width and height include labels.
\newcommand{\pkuResponsePlot}[2]{%
  \begin{tikzpicture}
  \begin{axis}[pku axis,width=#1,height=#2,
    xmin=0,xmax=12,ymin=-1,ymax=1.05,
    xlabel={$t$},ylabel={$u(t)$},
    xtick={0,3,6,9,12},ytick={-1,-.5,0,.5,1},
    legend style={at={(.5,1.04)},anchor=south,legend columns=3},
    domain=0:12,samples=121]
    \addplot {exp(-0.12*x)*cos(deg(x))};
    \addlegendentry{$\gamma=0.12$}
    \addplot {exp(-0.25*x)*cos(deg(x))};
    \addlegendentry{$\gamma=0.25$}
    \addplot {exp(-0.45*x)*cos(deg(x))};
    \addlegendentry{$\gamma=0.45$}
  \end{axis}
  \end{tikzpicture}%
}
\newcommand{\pkuCoverMotif}[1]{%
  \begin{tikzpicture}[x=#1/12,y=#1/16]
    \clip (0,-1.6) rectangle (12,1.6);
    \fill[pku-surface] (0,-1.6) rectangle (12,1.6);
    \foreach \g/\c in {0.08/pku-line,0.18/pku-primary,0.35/pku-secondary}{
      \draw[\c,semithick,domain=0:12,samples=100,smooth]
        plot (\x,{exp(-\g*\x)*cos(deg(1.5*\x))});
    }
  \end{tikzpicture}%
}
