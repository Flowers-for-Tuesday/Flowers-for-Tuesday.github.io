\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pku-beamer}[2026/11/18 v2.0 Editorial presentation theme]
\RequirePackage{pku}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{tikz}
\RequirePackage{pku-figures}
\mode<presentation>
\usefonttheme{professionalfonts}
\linespread{1.02}
\setbeamersize{text margin left=8mm,text margin right=8mm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamercovered{invisible}
\setbeamercolor{normal text}{fg=pku-ink,bg=pku-paper}
\setbeamercolor{background canvas}{bg=pku-paper}
\setbeamercolor{structure}{fg=pku-primary}
\setbeamercolor{alerted text}{fg=pku-primary}
\setbeamercolor{frametitle}{fg=pku-ink}
\setbeamercolor{footline}{fg=pku-muted,bg=pku-paper}
\setbeamercolor{block title}{fg=pku-primary,bg=pku-tint}
\setbeamercolor{block body}{fg=pku-ink,bg=pku-tint}
\setbeamercolor{block title alerted}{fg=pku-primary,bg=pku-surface}
\setbeamercolor{block body alerted}{fg=pku-ink,bg=pku-surface}
\setbeamercolor{block title example}{fg=pku-secondary,bg=white}
\setbeamercolor{block body example}{fg=pku-ink,bg=white}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamercolor{caption name}{fg=pku-primary}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{itemize item}{\color{pku-primary}\raise.25ex\hbox{\rule{.45ex}{.45ex}}}
\setbeamertemplate{itemize subitem}{\color{pku-muted}\textendash}
\setbeamertemplate{blocks}[rounded][shadow=false]

\def\@supervisor{}
\newcommand{\supervisor}[1]{\def\@supervisor{#1}}
\setbeamertemplate{title page}{%
  \vspace*{1mm}
  \pkulogo{34mm}\hfill{\color{pku-muted}\scriptsize SCHOOL OF PHYSICS}\par
  \vspace{3mm}{\color{pku-line}\hrule}\vspace{6mm}
  {\color{pku-primary}\scriptsize RESEARCH \& LEARNING\par}
  \vspace{3mm}
  {\fontsize{25}{30}\selectfont\bfseries\inserttitle\par}
  \ifx\insertsubtitle\@empty\else
    \vspace{2mm}{\large\color{pku-muted}\insertsubtitle\par}
  \fi
  \vspace{4mm}
  {\normalsize\insertauthor\par}
  {\scriptsize\color{pku-muted}\insertinstitute\par}
  \ifx\@supervisor\@empty\else
    {\scriptsize\color{pku-muted}Supervisor: \@supervisor\par}
  \fi
  \vfill
  \pkuCoverMotif{\textwidth}\par
  \vspace{2mm}{\scriptsize\color{pku-muted}\insertdate\par}
}
% The title occupies real vertical space, so text cannot overlap the heading.
\setbeamertemplate{frametitle}{%
  \vspace{1mm}
  \begin{beamercolorbox}[wd=\textwidth,sep=0pt]{frametitle}
    \begin{minipage}[c]{.84\textwidth}
      \usebeamerfont{frametitle}\insertframetitle
      \ifx\insertframesubtitle\@empty\else
        \par{\small\mdseries\color{pku-muted}\insertframesubtitle}
      \fi
    \end{minipage}\hfill
    \begin{minipage}[c]{.13\textwidth}\raggedleft\pkulogo{\linewidth}\end{minipage}
    \par\vspace{2mm}{\color{pku-line}\hrule height .35pt}
  \end{beamercolorbox}
  \vspace{1mm}
}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.7ex,dp=1.5ex,leftskip=8mm,rightskip=8mm]{footline}
    \scriptsize\insertshortauthor\enspace/\enspace\insertshorttitle
    \hfill{\color{pku-primary}\insertframenumber}\,\textcolor{pku-muted}{/ \inserttotalframenumber}
  \end{beamercolorbox}
}
\lstset{style=pku,basicstyle=\ttfamily\scriptsize,xleftmargin=7pt,framesep=6pt}
\mode<all>
\endinput
